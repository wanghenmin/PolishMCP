# =============================================================================
# AImcp 环境变量示例（复制为 .env 后按需修改；勿将含密钥的 .env 提交仓库）
# =============================================================================

# -----------------------------------------------------------------------------
# LLM 后端（OpenAI 兼容协议）
# -----------------------------------------------------------------------------
# LLM_API_KEY：调用大模型的密钥（必填）。
LLM_API_KEY=
# LLM_BASE_URL：OpenAI 兼容服务的基址，需带 /v1，仅基址不要带具体路径。
# 示例：http://127.0.0.1:8000/v1
LLM_BASE_URL=http://127.0.0.1:8000/v1
# LLM_MODEL：默认模型名称，未单独配置阶段模型时所有阶段共用。
LLM_MODEL=gemini-2.5-pro

# 可选：分阶段覆盖模型（留空则回退到 LLM_MODEL）。
POLISH_MODEL=
ENHANCE_MODEL=
EMOTION_MODEL=

# LLM_TEMPERATURE：采样温度。
LLM_TEMPERATURE=0.7
# LLM_TIMEOUT_S：单次请求超时（秒）。
LLM_TIMEOUT_S=60

# LLM_API_FORMAT：接口格式，chat（/v1/chat/completions）或 responses（/v1/responses）。
LLM_API_FORMAT=chat
# LLM_STREAM：是否走流式。部分网关（尤其 responses 非流式）不回填正文，需开启。
LLM_STREAM=false

# -----------------------------------------------------------------------------
# 思考模式（推理参数，与 temperature 互斥）
# -----------------------------------------------------------------------------
# THINKING_MODE_ENABLED：是否启用。开启后优先使用 reasoning_effort；
#   若调用失败且错误可重试，会自动降级为 temperature 重试一次。
THINKING_MODE_ENABLED=false
# THINKING_MODE_EFFORT：思考强度，如 none / low / medium / high（取决于后端模型支持）。
THINKING_MODE_EFFORT=high

# -----------------------------------------------------------------------------
# 分段处理
# -----------------------------------------------------------------------------
# SEGMENT_MAX_CHARS：单个段落最大长度（汉字/字母数），超出按句号再切分。
SEGMENT_MAX_CHARS=800
# SEGMENT_SKIP_THRESHOLD：短于该值的段落视为标题，原样透传、不送模型。
SEGMENT_SKIP_THRESHOLD=15
# HISTORY_MAX_SEGMENTS：每段携带的前文段数，用于保持改写风格一致。
HISTORY_MAX_SEGMENTS=5

# -----------------------------------------------------------------------------
# 传输模式
# -----------------------------------------------------------------------------
# MCP_TRANSPORT：stdio（本地宿主）| streamable-http（remote）| sse。
MCP_TRANSPORT=stdio
# remote 模式下的监听地址与端口。
MCP_HOST=127.0.0.1
MCP_PORT=8000
